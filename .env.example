# ── HOW TO USE ──
# Local dev:  GIN_MODE=debug,   BUILD_TAGS=         (seed data on, rate limiting off)
# Production: GIN_MODE=release, BUILD_TAGS=release  (seed data off, rate limiting on, secure cookies)

# ── Database (PostgreSQL) ──
DATABASE_URL=postgres://user:password@postgres:5432/finance_manager?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ── Authentication ──
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
INVITE_CODE=

# ── Server ──
PORT=8080
GIN_MODE=debug
BUILD_TAGS=
CORS_ORIGIN=*

# ── Rate Limiting ──
RATE_LIMIT=10
RATE_WINDOW_SECONDS=60

# ── Admin Dashboard ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Sync ──
SYNC_SESSION_TTL_DAYS=90

# ── Monitoring ──
SENTRY_DSN=

# ── Push Notifications (Pushy) ──
PUSHY_API_KEY=

# ── Email (Resend) ──
RESEND_API_KEY=
FROM_EMAIL=Finance Manager <noreply@example.com>

# ── Docker Compose ──
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=finance_manager
APP_PORT=8080
