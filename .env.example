# ── Database (PostgreSQL) ──
DATABASE_URL=postgres://user:password@localhost:5432/finance_manager?sslmode=disable  # Connection string; must start with postgres://
DB_MAX_CONNS=25          # Maximum database pool connections
DB_MIN_CONNS=5           # Minimum database pool connections

# ── Authentication ──
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars  # REQUIRED; must be ≥ 32 characters
INVITE_CODE=             # If set, signup requires this code; if empty, signup is open

# ── Server ──
PORT=8080                # HTTP listen port inside the container
GIN_MODE=debug           # "debug" or "release"; release enables rate limiting, secure cookies, disables SQL runner & seed data
CORS_ORIGIN=*            # Allowed CORS origin; set to your frontend URL in production

# ── Rate Limiting ──
RATE_LIMIT=10            # Max requests per window (applied to /auth/* routes)
RATE_WINDOW_SECONDS=60   # Rate limit window in seconds

# ── Admin Dashboard ──
ADMIN_USERNAME=admin     # Admin login username
ADMIN_PASSWORD=          # Admin login password; login disabled if empty (REQUIRED in release mode)

# ── Sync ──
SYNC_SESSION_TTL_DAYS=90  # Days before inactive sync sessions are expired by background cleanup

# ── Monitoring ──
SENTRY_DSN=              # Sentry DSN for error tracking; leave empty to disable (e.g. https://key@o123.ingest.sentry.io/456)

# ── Push Notifications (Pushy) ──
PUSHY_API_KEY=           # Pushy Secret API Key; leave empty to disable push notifications

# ── Email (Resend) ──
RESEND_API_KEY=          # Resend API key; leave empty to disable email sending (verification codes logged instead)
FROM_EMAIL=Finance Manager <noreply@example.com>  # Sender address for outgoing emails

# ── Docker Compose ──
POSTGRES_USER=user       # Postgres container superuser name
POSTGRES_PASSWORD=password  # Postgres container superuser password
POSTGRES_DB=finance_manager  # Postgres container database name
APP_PORT=8080            # Host port mapped to the app container
