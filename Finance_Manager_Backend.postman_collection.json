              "raw": "{{base_url}}/expenses/:id",
              "host": ["{{base_url}}"],
              "path": ["expenses", ":id"],
              "variable": [{ "key": "id", "value": "EXPENSE_ID" }]
            }
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
