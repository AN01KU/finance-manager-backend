                { "key": "start_date", "value": "2026-03-01", "disabled": true },
                { "key": "end_date", "value": "2026-03-31", "disabled": true },
                { "key": "group_id", "value": "", "disabled": true },
                { "key": "recurring_expense_id", "value": "", "disabled": true },
                { "key": "is_deleted", "value": "true", "disabled": true }
